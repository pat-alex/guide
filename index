<script>
(function(){
  document.querySelectorAll('.item-head').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.closest('.item');
      var isOpen = item.classList.contains('open');
      item.classList.toggle('open', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });

  var input = document.getElementById('searchInput');
  var topics = Array.from(document.querySelectorAll('.topic[data-topic]'));
  var noResults = document.getElementById('noResults');

  input.addEventListener('input', function(){
    var q = input.value.trim().toLowerCase();
    var anyVisible = false;

    topics.forEach(function(topic){
      var topicHasMatch = false;
      topic.querySelectorAll('.item[data-q]').forEach(function(item){
        var text = item.textContent.toLowerCase();
        var match = q === '' || text.indexOf(q) !== -1;
        item.hidden = !match;
        if(match) topicHasMatch = true;
      });
      topic.hidden = !topicHasMatch;
      if(topicHasMatch) anyVisible = true;
    });

    noResults.style.display = anyVisible ? 'none' : 'block';
  });

  var pills = Array.from(document.querySelectorAll('.pill'));
  var sections = ['loc','cert','exams','qual','accred','admin'].map(function(id){
    return document.getElementById(id);
  }).filter(Boolean);

  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        var id = entry.target.id;
        pills.forEach(function(p){
          p.classList.toggle('active', p.dataset.target === id);
        });
      }
    });
  }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });

  sections.forEach(function(s){ observer.observe(s); });
})();
</script>

